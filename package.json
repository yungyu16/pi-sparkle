{
  "name": "pi-sparkle",
  "version": "1.0.0",
  "description": "为 Pi 输入框添加轻柔闪烁的星光背景，灵感来自 Codex Astra Sparkle。 | A subtle sparkling background for the Pi editor, inspired by Codex Astra Sparkle.",
  "type": "module",
  "license": "MIT",
  "author": "Yungyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/yungyu16/pi-sparkle.git"
  },
  "homepage": "https://github.com/yungyu16/pi-sparkle",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "tui",
    "terminal",
    "animation",
    "codex",
    "codex-sparkle",
    "astra",
    "astra-sparkle",
    "starfield",
    "sparkle"
  ],
  "files": [
    "src/**/*.ts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/yungyu16/pi-sparkle/main/assets/pi-sparkle.png"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
